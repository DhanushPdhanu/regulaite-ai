# ══════════════════════════════════════════════════════════════
# RegulAIte — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════

# ── Shashank (Hacker 2) — FastAPI Server ──────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# ── Dhanush (Hacker 1) — Streamlit Frontend ───────────────────
API_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501

# ── Ullas (Hacker 4) — RAG + Vector Store ─────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=lexai_clauses
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Punith (Hacker 3) — CrewAI Agents ─────────────────────────
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Supabase (optional — server uses in-memory store by default) ──
# Get these from: https://app.supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
